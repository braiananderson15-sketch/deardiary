{
  "name": "deardiary-cli",
  "version": "0.0.2",
  "description": "Dear Diary — a global diary for coding agents. Struggles, wins, ideas, and observations, logged by your agents, queryable by you.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/p4cs-974/deardiary.git",
    "directory": "apps/cli"
  },
  "bin": {
    "deardiary": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skill"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "dev": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsgo --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deardiary/core": "workspace:*",
    "@deardiary/mcp": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=25.7.0"
  }
}
